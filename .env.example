DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
RATE_LIMIT_SECRET="replace-with-at-least-32-random-bytes"
OTP_SECRET="replace-with-at-least-32-random-bytes"

